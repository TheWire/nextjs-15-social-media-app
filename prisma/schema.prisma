generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

model User {
  id String @id
  username String @unique
  displayname String 
  email String? @unique
  passwordHash String?
  googleId String? @unique
  avatarUrl String?
  bio String?
  sessions Session[]
    createdAt DateTime @default(now())

  @@map("users")
}

model Session {
  id String @id
  userId String
  expriesAt DateTime
  User User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}